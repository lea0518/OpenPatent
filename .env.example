# === 生成模型（负责撰写专利文书）===
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=your_deepseek_api_key_here
LLM_MODEL=deepseek-chat

# === Embedding（负责向量化，调用 BAAI/bge-m3）===
# 同时作为评估裁判模型的默认来源（Qwen2.5-72B-Instruct）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# === 评估裁判模型（可选）===
# 三项都填才生效，用于覆盖默认裁判。留空则自动使用 SiliconFlow 的 Qwen2.5-72B。
# 建议裁判与生成模型来自不同厂商，以规避自我偏袒偏差。
# EVAL_API_BASE=
# EVAL_API_KEY=
# EVAL_MODEL=
